{
  "name": "rabbitevents/listener",
  "description": "The Listener component of the RabbitEvents library.",
  "keywords": [
    "laravel",
    "rabbitmq",
    "events",
    "listener",
    "microservices",
    "messaging",
    "amqp",
    "pubsub",
    "broadcast",
    "protobuf",
    "event-driven",
    "queue",
    "subscribe"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Eugene Kirdzei",
      "email": "masterjus@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "illuminate/console": "^11.0|^12.0|^13.0",
    "illuminate/container": "^11.0|^12.0|^13.0",
    "illuminate/events": "^11.0|^12.0|^13.0",
    "illuminate/log": "^11.0|^12.0|^13.0",
    "illuminate/pipeline": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "rabbitevents/foundation": "self.version",
    "ramsey/uuid": "^4.7"
  },
  "autoload": {
    "psr-4": {
      "RabbitEvents\\Listener\\": ""
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "RabbitEvents\\Listener\\ListenerServiceProvider"
      ],
      "aliases": {
        "RabbitEvents": "RabbitEvents\\Listener\\Facades\\RabbitEvents"
      }
    }
  },
  "suggest": {
    "ext-pcntl": "Required to use all features of the worker.",
    "rabbitevents/deduplication": "Skips messages redelivered after they were handled, using a Laravel cache store shared by the workers."
  }
}